# Template Environment Variable untuk Stamps Technical Assessment (Section A)
# Salin file ini menjadi .env dan isi dengan OpenWeatherMap API Key Anda.
# Pihak penilai / tester dapat mendaftar kunci API gratis di https://openweathermap.org/api

OPENWEATHER_API_KEY=your_openweathermap_api_key_here
PORT=3001
NODE_ENV=development
